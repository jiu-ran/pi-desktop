{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.cts",
    "packages/ui/src/**/*.ts",
    "scripts/checks/**/*.ts"
  ]
}
