{
  "name": "pi-desktop",
  "productName": "Pi Desktop",
  "private": true,
  "version": "0.9.13",
  "author": "jiu-ran",
  "description": "基于本机 Pi Coding Agent CLI 的跨平台桌面工作台（MyGo + Vue 3 + Go）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiu-ran/pi-desktop.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "mygo dev",
    "start": "mygo dev",
    "build": "mygo build",
    "dist": "mygo build",
    "build:ui": "npm run build --prefix packages/ui",
    "check": "node scripts/checks/run-checks.mjs && npm run check:go",
    "check:go": "go vet ./... && go test ./...",
    "check:changed": "node scripts/checks/run-checks.mjs --changed",
    "check:full": "node scripts/checks/run-checks.mjs --jobs=1 --verbose",
    "check:syntax": "node scripts/checks/syntax.mjs",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@lezer/markdown": "^1.8.1",
    "@types/node": "^25.6.0",
    "mygo-cli": "0.9.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "mygo-cli@0.9.1": true
  }
}
